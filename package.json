{
  "name": "verticalflash",
  "version": "1.0.0",
  "description": "Scan TikTok for winning short-form videos, analyze them shot by shot with Gemini, and remake them from your own brand clip library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/markvek/VerticalFlash.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:projects": "node --import tsx --test scripts/project-storage.test.ts",
    "lint": "eslint .",
    "analyze:library": "node --env-file-if-exists=.env.local --import tsx scripts/analyze-library-batch.ts"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@napi-rs/canvas": "^1.0.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^1.41.0",
    "next": "^15.0.0",
    "radix-ui": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "shadcn": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
