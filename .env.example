# Copy to .env.local. Everything here stays on your machine; nothing is
# committed. Restart `npm run dev` after changing values.

# ---- Required ---------------------------------------------------------------

# TikHub API key — TikTok scanning, video download, music lookup.
# Get one at https://tikhub.io (metered; see README "Costs").
TIKHUB_API_KEY=your_api_key_here

# Gemini API key (Google AI Studio) — shot analysis, clip matching, captions,
# shot planning, and AI clip generation. https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ---- Optional: paths --------------------------------------------------------

# Keep all runtime data (downloads, analysis, renders, clip library, JSON
# stores) outside the repo. Defaults to the repo root.
# DATA_DIR=/path/to/verticalflash-data

# Path to your brand description. Defaults to <DATA_DIR>/brand.config.json.
# BRAND_CONFIG=./brand.config.json

# ---- Optional: costs --------------------------------------------------------

# Generate ffmpeg test patterns instead of calling the (paid) Gemini video
# model — free end-to-end testing of the per-shot generation flow.
# GENAI_VIDEO_DRY_RUN=1

# Price per second of generated video, from
# https://ai.google.dev/gemini-api/docs/pricing. Until set, the generation
# panel shows "pricing not configured" instead of a dollar figure.
# NEXT_PUBLIC_GEMINI_VIDEO_PRICE_PER_SEC=0.00

# Text-model prices per million tokens, if the built-in defaults drift.
# NEXT_PUBLIC_GEMINI_PRICE_IN_PER_M=1.5
# NEXT_PUBLIC_GEMINI_PRICE_OUT_PER_M=7.5

# ---- Optional: TikTok publishing + analytics --------------------------------

# TikTok app credentials (sandbox is fine for personal use). Needed for the
# "Iterate on a top video" track and one-click upload to drafts.
# Create an app at https://developers.tiktok.com — needs the video.upload scope.
# TIKTOK_CLIENT_KEY=your_client_key_here
# TIKTOK_CLIENT_SECRET=your_client_secret_here
# Must be https — TikTok rejects http callbacks (run `npm run dev:https`;
# see README "HTTPS for TikTok login").
# TIKTOK_REDIRECT_URI=https://localhost:3000/api/tiktok/auth/callback

# TikTok creator cookie for TikHub's creator analytics (completion rate etc.).
#
# SECURITY NOTE: this is your full tiktok.com session cookie. Anyone holding
# it can act as your TikTok account. It is only read server-side and never
# leaves your machine except to TikHub's API. Only set it if you want the
# analytics dashboard, prefer a dedicated creator account, and never paste it
# anywhere else.
#
# To get it: log into tiktok.com as your creator account, open DevTools →
# Network, click any request to tiktok.com, and copy the FULL value of the
# `cookie` request header.
# TIKTOK_CREATOR_COOKIE=your_tiktok_com_cookie_here

# ---- Optional: storyboard flow (masters cut into shorts) --------------------

# Word-level timing engine for master videos: "whisperx" (default when the
# binary is found; word-accurate) or "gemini" (approximate, no local
# install). WhisperX install: `uv tool install whisperx` (or pipx).
# TRANSCRIBER=whisperx
# WHISPERX_BIN=/path/to/whisperx      # only if not on PATH or in ~/.local/bin
# WHISPERX_MODEL=large-v3-turbo       # any faster-whisper model name
# WHISPERX_LANGUAGE=en                # skip language detection
# WHISPERX_DEVICE=cpu                 # cpu (Apple Silicon) or cuda
# WHISPERX_COMPUTE_TYPE=int8
# WHISPERX_BATCH_SIZE=8

# Skip Gemini in the storyboard flow: segments come from the WhisperX
# sentences with heuristic roles and storyboards are assembled by rule.
# Free end-to-end testing of the flow (needs WhisperX).
# STORYBOARD_DRY_RUN=1
